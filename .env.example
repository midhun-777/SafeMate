# SafeMate — Environment Variables Template
# Copy this file to .env and provide your local/staging credentials.
# NEVER commit .env to version control.

# Application Environment (development, staging, production)
APP_ENV=development

# Supabase Configuration
# Public anon key is safe for client-side API requests governed by Row Level Security (RLS).
# NEVER include SUPABASE_SERVICE_ROLE_KEY in the client application.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder

# Feature Flags
ENABLE_JOURNEY_COPILOT=false
ENABLE_PASSIVE_SAFETY_ALERTS=true
